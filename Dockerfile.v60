# v60 — handler-only delta on top of v59.
#
# Same pattern as Dockerfile.v59: nothing image-side changes (ffmpeg
# is already in the base, no new deps). Layer the v60 handler over
# the proven-working v59 image and re-tag.
#
# What v60 adds: ffmpeg loudnorm two-pass mastering, opt-in via
# `master: true` on the input. When mastering is on, the MP3 bitrate
# bumps from 192 to 320 kbps so the codec doesn't undo the polish.
#
# To bake in a future Dockerfile-level change, restore patch_config.py
# and use the full ./Dockerfile build path.

FROM shoosty1/ace-step:v59

COPY handler.py /app/handler.py

CMD ["python", "/app/handler.py"]
